<?xml version="1.0"?>
<project name="deploy">
	<target name="checkForDEAuthorization">
		<!--Check to see if the org is already authorized on this machine-->
		<exec executable="${sf.command}"
			  failonerror="false"
			  resultproperty="sf.org.display.result"
		>
			<arg line="org display"/>
		</exec>
		<fail message="You don't have a default username set for this project directory.
You should either: 'sf org login web --set-default'
or 'sf config set target-org=[username]'">
			<condition>
				<not>
					<equals arg1="${sf.org.display.result}" arg2="0"/>
				</not>
			</condition>

		</fail>
	</target>

	<target name="deploy" depends="checkForDEAuthorization">
		<exec executable="${sf.command}" failonerror="true">
			<arg line="project deploy start -x manifest/package.xml --post-destructive-changes manifest/destructiveChanges.xml --ignore-conflicts"/>
		</exec>
	</target>

	<target name="retrieve" depends="checkForDEAuthorization">
		<exec executable="${sf.command}" failonerror="true">
			<arg line="project retrieve start -x manifest/package.xml"/>
		</exec>
	</target>

	<target name="test" depends="checkForDEAuthorization" unless="${skip.tests}">
		<exec executable="${sf.command}" failonerror="true">
			<arg line="apex run test -w 60 --verbose"/>
		</exec>
	</target>
</project>
